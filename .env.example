# Configuration locale unique (copier vers .env)
APP_NAME=POS Backend
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql://saas_user:change-me@localhost:5432/saas_db
OFFLINE_DATABASE_URL=sqlite:///./data/pos_offline.db
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=saas_db

SYNC_QUEUE_MAX_SIZE=255
SYNC_INTERVAL_SECONDS=5
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

SUPERUSER_EMAIL=admin@example.com
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=change-me
SUPERUSER_FULL_NAME=Super Admin

VITE_API_URL=http://localhost:8000
